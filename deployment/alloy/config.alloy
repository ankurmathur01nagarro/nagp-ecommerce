// ===================================================================
// Grafana Alloy configuration — replaces OTel Collector YAML pipelines
//
// Data-flow summary:
//   OTLP (gRPC :4317 / HTTP :4318)
//     → memory_limiter → batch "traces"  → jaeger + newrelic
//     → memory_limiter → batch "logs"    → loki   + newrelic
//     → memory_limiter → batch "metrics" → newrelic + prometheus (remote-write receiver)
// ===================================================================

// ======================= EXPORTERS =======================

// New Relic — all signals (traces, logs, OTLP metrics)
otelcol.exporter.otlphttp "newrelic" {
  client {
    endpoint = "https://otlp.eu01.nr-data.net:4318"
    headers  = {
      "api-key" = sys.env("NEW_RELIC_API_KEY"),
    }
    timeout = "5s"
    disable_keep_alives = true  // avoid hung HTTP/2 keep-alives on intermediaries
    // TLS: proper certificate validation for external endpoint
  }
  sending_queue {
    enabled       = true
    num_consumers = 4      // parallel export workers
    queue_size    = 500    // bounded — prevents unbounded memory growth on backpressure
  }
  retry_on_failure {
    enabled          = true
    initial_interval = "5s"
    max_interval     = "30s"
    max_elapsed_time = "120s"  // stop retrying after 2 min — drop data rather than OOM
  }
}

// Jaeger — traces only (OTLP gRPC)
otelcol.exporter.otlp "jaeger" {
  client {
    endpoint = "jaeger.observability.svc.cluster.local:4317"
    tls {
      insecure = true  // internal: Istio mTLS encrypts at mesh layer
    }
  }
}

// Loki — logs only (OTLP HTTP, native /otlp endpoint, Loki 3.x)
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki.observability.svc.cluster.local:3100/otlp"
    tls {
      insecure = true  // internal: Istio mTLS encrypts at mesh layer
    }
  }
}

// Prometheus — metrics only (remote-write to Prometheus server)
otelcol.exporter.prometheusremotewrite "prometheus" {
  client {
    endpoint = "http://prometheus-server.observability.svc.cluster.local:80/api/v1/write"
    tls {
      insecure = true  // internal: Istio mTLS encrypts at mesh layer
    }
  }
}

// ======================= PROCESSORS (per-signal) =======================
// Alloy's component model requires per-signal output routing, so each
// signal type gets its own batch processor with the appropriate exporters.

otelcol.processor.batch "traces" {
  timeout         = "5s"
  send_batch_size = 512
  output {
    traces = [otelcol.exporter.otlp.jaeger.input, otelcol.exporter.otlphttp.newrelic.input]
  }
}

otelcol.processor.batch "logs" {
  timeout         = "5s"
  send_batch_size = 512
  output {
    logs = [otelcol.exporter.otlphttp.loki.input, otelcol.exporter.otlphttp.newrelic.input]
  }
}

otelcol.processor.batch "metrics" {
  timeout         = "5s"
  send_batch_size = 512
  output {
    metrics = [otelcol.exporter.otlphttp.newrelic.input, otelcol.exporter.prometheusremotewrite.prometheus.input]
  }
}

// ======================= MEMORY LIMITER =======================
// Must be the first processor in every pipeline. Prevents OOM by
// refusing data when memory exceeds limit. Works with GOMEMLIMIT env var.

otelcol.processor.memory_limiter "default" {
  check_interval = "1s"
  limit          = "400MiB"
  spike_limit    = "100MiB"
  output {
    traces  = [otelcol.processor.batch.traces.input]
    logs    = [otelcol.processor.batch.logs.input]
    metrics = [otelcol.processor.batch.metrics.input]
  }
}

// ======================= RECEIVERS =======================

// OTLP receiver — apps send traces, logs, and metrics here
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces  = [otelcol.processor.memory_limiter.default.input]
    logs    = [otelcol.processor.memory_limiter.default.input]
    metrics = [otelcol.processor.memory_limiter.default.input]
  }
}
