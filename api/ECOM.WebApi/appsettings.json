{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": []
  },
  "OpenIddict": {
    "Issuer": "http://localhost:5000"
  },
  "ExternalAuth": {
    "SuccessCallbackPath": "/auth/callback",
    "ErrorCallbackPath": "/notloggedin"
  },
  "IdentityApi": {
    "BaseUrl": "http://localhost:5000",
    "ClientId": "ecom-api",
    "ClientSecret": "9f8a7b6c-5d4e-3f2a-1b0c-9d8e7f6a5b4c"
  },
  "ReverseProxy": {
    "Routes": {
      "images": {
        "ClusterId": "imgproxy",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/productimages/{id}" },
        "Transforms": [
          { "ImgproxyLookup": "true" }
        ]
      },
      "identity-authorize": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/connect/authorize" },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "identity-google-callback": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/google/callback" },
        "Transforms": []
      }
    },
    "Clusters": {
      "imgproxy": {
        "Destinations": {
          "primary": { "Address": "http://localhost:8080" }
        }
      },
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  },
  "ProductApi": {
    "BaseUrl": "http://localhost:5002"
  },
  "InventoryApi": {
    "BaseUrl": "http://localhost:5003"
  }
}
