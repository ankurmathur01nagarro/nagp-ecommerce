FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /App

COPY . .
RUN dotnet restore ./ECOM.ProductApi.MigrationJob/ECOM.ProductApi.MigrationJob.csproj
RUN dotnet publish ./ECOM.ProductApi.MigrationJob/ECOM.ProductApi.MigrationJob.csproj -o out

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /App
COPY --from=build /App/out .

ENTRYPOINT ["dotnet", "ECOM.ProductApi.MigrationJob.dll"]
